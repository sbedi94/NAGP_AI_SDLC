+using InvoiceApp.Domain;
+using Xunit;
+
+namespace InvoiceApp.Tests;
+
+public class ApprovalServiceConcurrencyTests
+{
+    [Fact]
+    public async Task Approve_ConcurrentRequestsForSameInvoice_OnlyOneSucceeds()
+    {
+        var invoice = new Invoice
+        {
+            Id = "INV-1",
+            CustomerName = "Test School",
+            Amount = 100m,
+            Status = InvoiceStatus.PendingApproval
+        };
+        var service = new ApprovalService(new FakeInvoiceRepository(invoice));
+
+        var outcomes = await Task.WhenAll(
+            Task.Run(() => ApproveOrConflict(service, "approver-one")),
+            Task.Run(() => ApproveOrConflict(service, "approver-two")));
+
+        Assert.Equal(1, outcomes.Count(succeeded => succeeded));
+        Assert.Equal(1, outcomes.Count(succeeded => !succeeded));
+    }
+
+    private static bool ApproveOrConflict(ApprovalService service, string approver)
+    {
+        try
+        {
+            service.Approve("INV-1", approver);
+            return true;
+        }
+        catch (InvalidOperationException)
+        {
+            return false;
+        }
+    }
+}
