    approver -->|"Uses approval UI"| browser
    staticUiHost -->|"Serves UI assets over HTTPS"| browser
    browser -->|"HTTPS; authenticated approval request<br/>Current role-gate reference: ApprovalsController.cs and Auth/RequireRoleAttribute.cs"| api
    api -->|"Routes approval endpoint"| approvalController
    approvalController -->|"Invokes approval operation"| approvalService

    approvalService -->|"Calls repository"| sqlRepository
    sqlRepository -->|"PROPOSED / NOT IMPLEMENTED — Transactional outbox: one SQL transaction approves invoice, creates PaymentSubmission, appends audit record, and inserts outbox event. Commit or roll back together."| sql
    approvalService -->|"Returns result after transaction commits"| approvalController
    approvalController -->|"Returns API result"| api
    api -->|"Approval response"| browser

    outboxPublisher -->|"PROPOSED / NOT IMPLEMENTED — Poll/claim undispatched outbox events"| sql
    outboxPublisher -->|"PROPOSED / NOT IMPLEMENTED — Publish payment intent; duplicates possible if publish succeeds but dispatch mark fails"| queue
    outboxPublisher -->|"PROPOSED / NOT IMPLEMENTED — Mark event dispatched after broker acknowledgment"| sql

    queue -->|"PROPOSED / NOT IMPLEMENTED — At-least-once delivery; duplicates are expected and handled"| paymentWorker
    paymentWorker -->|"PROPOSED / NOT IMPLEMENTED — Load/claim PaymentSubmission; enforce unique submission and persist attempt state"| sql
    paymentWorker -->|"PROPOSED / NOT IMPLEMENTED — HTTPS submit; stable idempotency key from immutable PaymentSubmission ID"| payex
    payex -->|"Provider receipt or definitive result; contract support to verify"| paymentWorker
    paymentWorker -->|"PROPOSED / NOT IMPLEMENTED — Persist provider reference, outcome, attempts and audit event"| sql

    paymentWorker -->|"PROPOSED / NOT IMPLEMENTED — Transient failure: bounded backoff and retry; same idempotency key"| queue
    paymentWorker -->|"PROPOSED / NOT IMPLEMENTED — Retry limit reached or non-retryable processing failure"| dlq
    dlq -->|"PROPOSED / NOT IMPLEMENTED — Alert; inspect and reconcile before controlled replay"| operations
    operations -->|"PROPOSED / NOT IMPLEMENTED — Authorized replay after duplicate/status checks"| queue

    paymentWorker -->|"PROPOSED / NOT IMPLEMENTED — Timeout or connection loss: record outcome as UNKNOWN; do not assume PayEx did not process"| sql
    reconciliation -->|"PROPOSED / NOT IMPLEMENTED — Find UNKNOWN / stale submissions"| sql
    reconciliation -->|"PROPOSED / NOT IMPLEMENTED — Query provider status/reference before deciding whether to retry"| payex
    payex -->|"Provider lookup result, if supported by contract"| reconciliation
    reconciliation -->|"PROPOSED / NOT IMPLEMENTED — Record reconciled outcome and audit evidence; retry only when safe"| sql
    reconciliation -->|"PROPOSED / NOT IMPLEMENTED — Unresolved or mismatched state requires investigation"| operations

    auditRetention["PROPOSED / NOT IMPLEMENTED — Retention policy and controls<br/>Keep audit records for seven years"]
    auditRetention -->|"Applies to AuditRecords; verify archival, immutability and deletion controls"| sql

    exactlyOnce["Important: the transactional outbox makes invoice approval and payment intent atomic in Azure SQL; neither the outbox nor Service Bus guarantees exactly-once external payment effects. Duplicate protection depends on persisted deduplication and PayEx idempotency support/semantics. Timeout recovery also depends on PayEx status queries or manual reconciliation."]
